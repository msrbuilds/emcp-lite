{
    "name": "msrbuilds/emcp-lite",
    "description": "EMCP Lite WordPress MCP plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
    "automattic/jetpack-autoloader": "^6.0",
    "wordpress/mcp-adapter": "^0.7.0",
        "enshrined/svg-sanitize": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9 || ^10"
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true
        },
        "autoloader-suffix": "EmcpLite100"
    }
}
